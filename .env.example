# Copy to .env and fill in. .env is gitignored; this file is safe to commit.

# ---- project ----------------------------------------------------------
PROJECT_NAME=rag-project

# ---- required credentials --------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
PINECONE_API_KEY=

# Index must match EMBEDDING_DIMENSIONS below, metric=cosine.
# Set the host to skip the name lookup (needed when the key and index live in
# different Pinecone projects).
PINECONE_INDEX_NAME=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=

# ---- data -------------------------------------------------------------
# Folder scanned by `python ingest.py` (relative to the template folder).
DATA_DIR=data
SUPPORTED_EXTENSIONS=.pdf,.txt,.md

# ---- chunking ---------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ---- models -----------------------------------------------------------
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
LLM_MODELS=gemini-2.5-flash,gemini-2.0-flash
TEMPERATURE=0.4

# ---- retrieval --------------------------------------------------------
TOP_K=4
# Drop matches below this cosine score (0 = keep everything).
MIN_SCORE=0.0

# ---- prompt -----------------------------------------------------------
# Override per project, e.g. "You are an HR policy assistant..."
# SYSTEM_PROMPT=
